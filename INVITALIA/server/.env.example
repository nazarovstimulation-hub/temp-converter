# Copy to .env and fill in. Lines starting with # are ignored.

PORT=8787
HOST=0.0.0.0
# Public address of this deployment (used for invitation links, QR codes and Stripe redirects)
BASE_URL=https://invitalia.co

# Static site folder (relative to this file)
SITE_DIR=../site
# SQLite database (relative to this file). On Render/Railway mount a persistent disk here.
DATABASE_PATH=./data/invitalia.db

# Stripe. Leave STRIPE_SECRET_KEY empty to run payments in MOCK mode (publishes immediately, for local testing only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price in minor units (2900 = 29.00) and ISO currency
PRICE_AMOUNT=2900
PRICE_CURRENCY=eur

# If the static site is hosted elsewhere (e.g. GitHub Pages), list its origins here
CORS_ORIGINS=https://invitalia.co,https://www.invitalia.co

# Set to 1 behind a reverse proxy / PaaS so rate limits use the real client IP
TRUST_PROXY=1
